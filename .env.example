# ============================================================
# GEOSUN — Variables de Entorno
# Copia este archivo como .env.local para desarrollo local
# NUNCA subas .env.local al repositorio
# ============================================================

# --- Supabase ---
# Obtenlas en: https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key-publica>

# Solo para scripts de servidor/migraciones (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key-secreta>

# --- Next.js ---
# URL base de la aplicación (sin trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Vercel (para GitHub Actions CI/CD) ---
# Añadir como GitHub Secrets, no aquí
# VERCEL_TOKEN=<token-from-vercel-account-settings>
# VERCEL_ORG_ID=<from-vercel-project-settings>
# VERCEL_PROJECT_ID=<from-vercel-project-settings>
